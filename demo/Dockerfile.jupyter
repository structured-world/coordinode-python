# quay.io is where Project Jupyter publishes its images now; the Docker Hub
# copy stopped receiving updates in October 2023.
FROM quay.io/jupyter/scipy-notebook:python-3.13.15

USER root
RUN apt-get update && apt-get install -y --no-install-recommends gcc git && rm -rf /var/lib/apt/lists/*

# Copy and chmod install script while still root
COPY install-sdk.sh /tmp/install-sdk.sh
RUN chmod +x /tmp/install-sdk.sh
COPY requirements.txt /tmp/demo-requirements.txt

USER ${NB_UID}

# The graph + LLM orchestration stack, from the hashed lock compiled from
# requirements.in, and wheels only, so no package runs setup code here.
RUN pip install --no-cache-dir --only-binary :all: --require-hashes -r /tmp/demo-requirements.txt

WORKDIR /home/jovyan/work
