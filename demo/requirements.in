# What the demo image installs on top of the Jupyter base. requirements.txt is
# the full lock compiled from this file (hashes included); regenerate it with
#   uv pip compile demo/requirements.in --universal --python-version 3.13 \
#     --generate-hashes -o demo/requirements.txt
# Versions that uv.lock also resolves are pinned to the same value, so the demo
# runs the stack the test suite runs.

# Build tools for the SDK's editable installs (hatch-vcs reads the version
# from git tags).
hatchling
hatch-vcs
